# Loaded by `vite build --mode pages`. Selects the serverless backend.
VITE_BACKEND=local

# Cloud sync. Both are public values baked into the bundle, which is expected:
# the client id is not a secret and the Worker URL is called from the browser.
# Leave them blank and the account UI does not render at all.
VITE_SYNC_API=https://lightblueprep-sync.kristpaulm.workers.dev
VITE_GOOGLE_CLIENT_ID=935646101294-kc3gqoo8a85pf5jl9ok2712ccijtquc0.apps.googleusercontent.com

# Donation page (Ko-fi, Buy Me a Coffee...). Blank hides the Support link.
VITE_DONATE_URL=https://ko-fi.com/kristpaulmendoza
# Second option, listed on the About page only.
VITE_DONATE_ALT_URL=https://buymeacoffee.com/KristPaulMendoza
# Thai PromptPay QR (bank-app card, cropped to the QR, metadata stripped).
VITE_PROMPTPAY_QR=/promptpay.png

# Our own Desmos API key (desmos.com/my-api). Blank = the Calculator button opens
# desmos.com/calculator in a new tab instead of embedding it.
VITE_DESMOS_KEY=e0a2eca0728c47e6a8476e5a0b6229f4

# Cloudflare Web Analytics site token (dashboard, Web Analytics). Public by
# design. Blank = no beacon. Forks: blank it or use your own.
VITE_CF_BEACON=
