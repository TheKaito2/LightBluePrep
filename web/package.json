{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/copy_fonts.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/copy_fonts.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "prebuild:pages": "node ../scripts/copy_fonts.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview:pages": "vite preview --outDir dist-pages"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
