# Cloudflare Pages response headers for LightBluePrep.
# The script hash is the inline MathJax config in index.html: if that block
# changes, recompute it (sha256, base64) or MathJax stops loading. Desmos's
# calculator needs 'unsafe-eval'; inline scripts stay blocked.
# img-src: every image in the question bank is an inline data: URI, so images
# may come only from this site, data:/blob:, and Desmos. That also stops an
# injected <img> or CSS url() from beaconing anywhere else.
# Cloudflare Web Analytics (src/lib/usage.ts): the one beacon script by exact
# path, and cloudflareinsights.com to receive what it reports.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-nSDD8RPwsKtoaGGW7MQC9IQHuRErkl6Wo0XnL/y1cwU=' https://accounts.google.com/gsi/client https://www.desmos.com https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://www.desmos.com; font-src 'self' data: https://www.desmos.com; connect-src 'self' https://qbank-api.collegeboard.org https://saic.collegeboard.org https://lightblueprep-sync.kristpaulm.workers.dev https://accounts.google.com/gsi/ https://www.desmos.com https://cloudflareinsights.com; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build output never changes under the same name, so it can be cached
# for a year; index.html (max-age=0 by default) is what points at new hashes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# MathJax sits under its version number (lib/mathjax.ts), so the file under a
# given name never changes and can be cached like the hashed build. A new
# MathJax goes in a new folder.
/mathjax/*
  Cache-Control: public, max-age=31536000, immutable

# Changes only when the types are re-merged. A day fresh, then served from
# cache while it revalidates; lib/similar.ts reads both the old and new shape.
/process-types.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icons and the share card change about never, but keep their names when they
# do, so a week rather than immutable.
/favicon*
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-card.png
  Cache-Control: public, max-age=604800
