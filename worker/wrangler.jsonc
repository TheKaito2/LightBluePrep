// LightBluePrep sync Worker. Deploy: `cd worker && npx wrangler deploy`.
// Secrets (not in this file): `npx wrangler secret put GOOGLE_CLIENT_ID`.
{
  "name": "lightblueprep-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Workers Logs off. Persisted logs keep each request's metadata, the
  // visitor's IP included, and privacy.html promises the IP is never stored.
  // console.error still reaches `npx wrangler tail` live, which stores nothing.
  // The dashboard has its own switch (Settings, Observability): keep it off too.
  "observability": { "enabled": false },
  // Abuse stops. Feedback, sign-in and the usage count are keyed by IP, or an
  // IPv6 /64 (only a key, never stored); sync is keyed by account. A real
  // client stays far under all four: a browser sends a milestone twice, ever.
  // /health reports how many are bound, and the watchdog wants all four.
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "MILESTONE_LIMITER", "namespace_id": "1004", "simple": { "limit": 2, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightblueprep",
      "database_id": "b1dd4f11-0f27-4796-834a-5d03d03bfffd"
    }
  ]
}
